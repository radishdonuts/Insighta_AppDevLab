# FastAPI server port
PORT=8000

# Deployed frontend origin allowed by CORS
FRONTEND_URL=https://insighta-psi.vercel.app/

# Optional comma-separated extra allowed origins
# Example: https://your-vercel-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=https://insighta-psi.vercel.app/,http://localhost:3001

# Preferred: absolute path to the exported NLP artifact folder
NLP_ARTIFACT_DIR=C:\path\to\Insighta_AppDevLab\backend\artifacts\distilbert_complaint_twohead_20260305_030951

# Alternative artifact configuration if you want to split base folder + run id
# Leave blank when using NLP_ARTIFACT_DIR directly
NLP_ARTIFACT_BASE_DIR=
NLP_ARTIFACT_RUN_ID=
